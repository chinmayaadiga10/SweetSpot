<% layout("/layouts/boilerplate.ejs")%>

<body>
  <h2>Edit this listing</h2>
  <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">
    <input
      type="text"
      name="listing[title]"
      id="title"
      placeholder="enter title"
      value="<%=listing.title%>"
    />
    <br />
    <textarea
      name="listing[description]"
      id="description"
      name="description"
      id="description"
    >
<%=listing.description%></textarea
    >
    <br />
    <input
      type="text"
      value="<%=listing.image%>"
      name="listing[image]"
      id="image"
    />
    <br />
    <input
      type="number"
      value="<%=listing.price%>"
      name="listing[price]"
      id="price"
    />
    <br />
    <input
      type="text"
      value="<%=listing.location%>"
      name="listing[location]"
      id="location"
    />
    <br />
    <input
      type="text"
      value="<%=listing.country%>"
      name="listing[country]"
      id="country"
    />
    <br />
    <button type="submit">Edit Listing</button>
  </form>
</body>
