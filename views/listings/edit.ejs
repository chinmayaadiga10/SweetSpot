<% layout("/layouts/boilerplate.ejs")%>

<div class="row">
  <div class="col-8 offset-2">
    <h2 class="mt-4">Edit this listing</h2>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          name="listing[title]"
          id="title"
          placeholder="enter title"
          value="<%=listing.title%>"
          class="form-control"
        />
      </div>
      <div class="mb-3">
        <label for="description">Description</label>
        <textarea
          name="listing[description]"
          id="description"
          name="description"
          id="description"
          class="form-control"
        >
        <%=listing.description%></textarea
        >
      </div>
      <div class="mb-3">
        <label for="image" class="form-label">Image</label>
        <input
          type="text"
          value="<%=listing.image%>"
          name="listing[image]"
          id="image"
          class="form-control"
        />
      </div>
      <div class="row">
        <div class="col-4 mb-3">
          <label for="price" class="form-label">Price</label>
          <input
            type="number"
            value="<%=listing.price%>"
            name="listing[price]"
            id="price"
            class="form-control"
          />
        </div>
        <div class="col-4 mb-3">
          <label for="country" class="form-label">Country</label>
          <input
            type="text"
            value="<%=listing.country%>"
            name="listing[country]"
            id="country"
            class="form-control"
          />
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          type="text"
          value="<%=listing.location%>"
          name="listing[location]"
          id="location"
          class="form-control"
        />
      </div>

      <button type="submit" class="btn btn-dark mt-4">Edit Listing</button>
    </form>
  </div>
</div>
