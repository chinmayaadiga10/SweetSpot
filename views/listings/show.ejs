<% layout("/layouts/boilerplate.ejs")%>

<div class="row mt-4">
  <div class="col-8 offset-2">
    <h2><%=listing.title%></h2>
    <div class="card listing-card">
      <img
        src="<%=listing.image%>"
        class="card-img-top show-image"
        alt="listing-image"
      />
      <div class="card-body">
        <h5 class="card-title mt-3"><b><%=listing.title%></b></h5>
        <p class="card-text"><%=listing.description%></p>
        <p class="card-text">
          &#8377;<%=listing.price.toLocaleString('en-IN')%>
        </p>
        <p class="card-text"><%=listing.location%></p>
        <p class="card-text"><%=listing.country%></p>
      </div>
    </div>
  </div>
</div>

<div class="show-actions">
  <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark me-5"
    >Edit this listing</a
  >
  <form action="/listings/<%=listing._id%>?_method=DELETE" method="POST">
    <button type="submit" class="btn btn-danger">Delete this listing</button>
  </form>
</div>

<div class="line"></div>

<div class="col-8 offset-2">
  <h3 class="mb-5 mt-5">Leave a Review</h3>
  <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
    <div class="mb-3">
      <label for="rating" class="form-label">Rating</label>
      <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range"/>
    </div>
    <div class="mb-3">
      <label for="comment" class="form-label">Comment</label>
      <textarea
        name="review[comment]"
        id="comment"
        rows="5"
        cols="30"
        class="form-control"
        required
      ></textarea>
        <div class="valid-feedback">Comment Looks Good</div>
        <div class="invalid-feedback">Please add a valid Comment</div>
    </div class="mb-3">
    <button type="submit" class="btn btn-outline-dark mb-5">Post Review</button>
  </form>

</div>
<div class="line"></div>
<div class="col-8 offset-2">
    <h3 class="mt-4 mb-4">All Reviews</h3>
  
    <div class="row">
     <%for (let review of listing.reviews){%>
            <div class="card col-5 mb-4 ms-3">
                <div class="card-body">
                    <h5 class="card-title mt-2">Steve Smith</h5>
                    <p class="card-text"><%=review.comment%></p>
                    <p class="card-text"><%=review.rating%> stars</p>
                 </div>
            </div>        
     <%}%>
    </div>
</div>


